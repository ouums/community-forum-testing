# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实口令
# PowerShell: Copy-Item .env.example .env

# 被测 Flarum 实例。默认只允许本地地址；远程地址需同时设置 FORUM_ALLOW_REMOTE_TESTS=1
FORUM_BASE=http://localhost:8080
FORUM_USER=testuser
FORUM_PWD=change-me

# 仅在已获授权的远程测试环境设为 1；本地实例不需要
# FORUM_ALLOW_REMOTE_TESTS=1

# UI 自动化可选靶点（按自己的实例调整）
FORUM_DISCUSSION_ID=1
FORUM_SEARCH_KEYWORD=123
FORUM_TAG_NAME=测试技术类
